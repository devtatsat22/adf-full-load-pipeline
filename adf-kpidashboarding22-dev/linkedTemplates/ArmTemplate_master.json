{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-kpidashboarding22-dev"
		},
		"LS_ADLS_Main_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_Main'"
		},
		"SqlServerOnPrem_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SqlServerOnPrem'"
		},
		"LS_ADLS_Main_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sakpidashboarding22dev.dfs.core.windows.net/"
		},
		"SqlServerOnPrem_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost,1433"
		},
		"SqlServerOnPrem_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "PracticeDB"
		},
		"SqlServerOnPrem_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adf_user"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-kpidashboarding22-dev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_Main_accountKey": {
						"value": "[parameters('LS_ADLS_Main_accountKey')]"
					},
					"SqlServerOnPrem_password": {
						"value": "[parameters('SqlServerOnPrem_password')]"
					},
					"LS_ADLS_Main_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Main_properties_typeProperties_url')]"
					},
					"SqlServerOnPrem_properties_typeProperties_server": {
						"value": "[parameters('SqlServerOnPrem_properties_typeProperties_server')]"
					},
					"SqlServerOnPrem_properties_typeProperties_database": {
						"value": "[parameters('SqlServerOnPrem_properties_typeProperties_database')]"
					},
					"SqlServerOnPrem_properties_typeProperties_userName": {
						"value": "[parameters('SqlServerOnPrem_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}