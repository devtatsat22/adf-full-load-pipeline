{
	"name": "PL_Incremental_SQLtoADLS",
	"properties": {
		"activities": [
			{
				"name": "Lookup_ActiveTables",
				"description": "get the list of active tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "select ControlId, SourceSchemaName, SourceTableName, WatermarkColumn, LastLoadValue\nFROM ctrl.PipelineControl\nwhere IsActive = 1",
						"queryTimeout": "00:10:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_Generic_Table",
						"type": "DatasetReference",
						"parameters": {
							"p_SchemaName": "ctrl",
							"p_TableName": "PipelineControl"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Table",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_ActiveTables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_ActiveTables').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Lookup_CurrentMaxWatermark",
							"description": "get the current max watermark from the source table",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"sqlReaderQuery": {
										"value": "@concat('SELECT MAX(', item().WatermarkColumn , ') AS MaxWatermark FROM ', item().SourceSchemaName, '.' , item().SourceTableName)",
										"type": "Expression"
									},
									"queryTimeout": "00:10:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_SQL_Generic_Table",
									"type": "DatasetReference",
									"parameters": {
										"p_SchemaName": {
											"value": "@item().SourceSchemaName",
											"type": "Expression"
										},
										"p_TableName": {
											"value": "@item().SourceTableName",
											"type": "Expression"
										}
									}
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "Copy_IncrementalData",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Lookup_CurrentMaxWatermark",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"sqlReaderQuery": {
										"value": "@concat('SELECT * FROM ', item().SourceSchemaName, '.', item().SourceTableName,\n' WHERE ', item().WatermarkColumn, ' > ''', item().LastLoadValue, '''',\n' AND ', item().WatermarkColumn, ' <= ''', activity('Lookup_CurrentMaxWatermark').output.firstRow.MaxWatermark, '''')",
										"type": "Expression"
									},
									"queryTimeout": "00:10:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_SQL_Generic_Table",
									"type": "DatasetReference",
									"parameters": {
										"p_SchemaName": {
											"value": "@item().SourceSchemaName",
											"type": "Expression"
										},
										"p_TableName": {
											"value": "@item().SourceTableName\r\n",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_Sink_File",
									"type": "DatasetReference",
									"parameters": {
										"p_Container": {
											"value": "@pipeline().parameters.p_SinkContainer",
											"type": "Expression"
										},
										"p_FolderPath": {
											"value": "@item().SourceTableName",
											"type": "Expression"
										},
										"p_FileName": {
											"value": "@concat(item().SourceTableName,'_',pipeline().RunId,'.csv')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "SP_UpdateControl_Success",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Copy_IncrementalData",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[ctrl].[usp_UpdateControl_Success]",
								"storedProcedureParameters": {
									"ControlId": {
										"value": {
											"value": "@item().ControlId",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"NewWatermarkValue": {
										"value": {
											"value": "@activity('Lookup_CurrentMaxWatermark').output.firstRow.MaxWatermark",
											"type": "Expression"
										},
										"type": "DateTime"
									},
									"RunDateTime": {
										"value": {
											"value": "@utcNow()",
											"type": "Expression"
										},
										"type": "DateTime"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "SqlServerOnPrem",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "SP_InsertLog_Success",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Copy_IncrementalData",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[ctrl].[usp_InsertLog]",
								"storedProcedureParameters": {
									"EndTime": {
										"value": {
											"value": "@utcNow()",
											"type": "Expression"
										},
										"type": "DateTime"
									},
									"ErrorMessage": {
										"value": "",
										"type": "String"
									},
									"PipelineName": {
										"value": {
											"value": "@pipeline().Pipeline",
											"type": "Expression"
										},
										"type": "String"
									},
									"RowsCopied": {
										"value": {
											"value": "@activity('Copy_IncrementalData').output.rowsCopied",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"RunId": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"StartTime": {
										"value": {
											"value": "@activity('Copy_IncrementalData').output.executionDetails[0].start",
											"type": "Expression"
										},
										"type": "DateTime"
									},
									"Status": {
										"value": "Success",
										"type": "String"
									},
									"TableName": {
										"value": {
											"value": "@item().SourceTableName\n",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "SqlServerOnPrem",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "SP_UpdateControl_Failure",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Copy_IncrementalData",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[ctrl].[usp_UpdateControl_Failure]",
								"storedProcedureParameters": {
									"ControlId": {
										"value": {
											"value": "@item().ControlId",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"RunDateTime": {
										"value": {
											"value": "@utcNow()",
											"type": "Expression"
										},
										"type": "DateTime"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "SqlServerOnPrem",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "SP_InsertLog_Failure",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Copy_IncrementalData",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[ctrl].[usp_InsertLog]",
								"storedProcedureParameters": {
									"EndTime": {
										"value": {
											"value": "@utcNow()\n",
											"type": "Expression"
										},
										"type": "DateTime"
									},
									"ErrorMessage": {
										"value": {
											"value": "@string(activity('Copy_IncrementalData').Error.Message)",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineName": {
										"value": {
											"value": "@pipeline().Pipeline",
											"type": "Expression"
										},
										"type": "String"
									},
									"RowsCopied": {
										"value": "0",
										"type": "Int32"
									},
									"RunId": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"StartTime": {
										"value": {
											"value": "@utcNow()",
											"type": "Expression"
										},
										"type": "DateTime"
									},
									"Status": {
										"value": "Failed",
										"type": "String"
									},
									"TableName": {
										"value": {
											"value": "@item().SourceTableName",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "SqlServerOnPrem",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_SinkContainer": {
				"type": "string",
				"defaultValue": "incremental-sink"
			}
		},
		"annotations": []
	}
}